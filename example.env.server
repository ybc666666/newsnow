G_CLIENT_ID=
G_CLIENT_SECRET=
JWT_SECRET=
INIT_TABLE=true
ENABLE_CACHE=true
PRODUCTHUNT_API_TOKEN=
# 历史热点明细表 hot_snapshot 的保留天数，按天聚合的 hot_daily 永久保留
HISTORY_RETENTION_DAYS=10

# PostgreSQL 连接：运行时由 pg 从以下 PG* 变量读取，不是 DATABASE_URL
PGHOST=127.0.0.1
PGPORT=5432
PGUSER=newsnow
PGPASSWORD=
PGDATABASE=newsnow